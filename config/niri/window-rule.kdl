// Firefox Picture-in-Picture: open floating
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Thunar: open floating by default
window-rule {
    match app-id=r#"[Tt]hunar"#
    open-floating true
    opacity 0.8
    draw-border-with-background false
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.5; }
}

// Rounded corners for all windows
window-rule {
    geometry-corner-radius 13
    clip-to-geometry true
    background-effect {
        blur true
    }
}

// Noctalia: the settings window opens floating at a fixed size.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

// Noctalia: blur what is behind its layer surfaces instead of sampling the wallpaper.
// Noctalia publishes its blur regions on its own; `xray false` only changes what they
// sample. Drop this rule, or set `blur false`, to turn the blur off. (niri >= 26.04)
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

